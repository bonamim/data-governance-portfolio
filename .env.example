# Copy to .env and adjust. .env is gitignored and never committed (production reads
# secrets from a secrets manager — see docs/production-readiness.md X1).

# ---------------------------------------------------------------------------
# Postgres — operational source (stands in for the company's OLTP system)
# ---------------------------------------------------------------------------
OLTP_DB=shop_oltp
OLTP_SUPERUSER=postgres
OLTP_SUPERUSER_PASSWORD=local_oltp_superuser
OLTP_PORT=5432
# Least-privilege role the platform uses to read the source
OLTP_READER_PASSWORD=local_oltp_reader
# Role the seed step uses to load the Olist operational tables
OLTP_LOADER_PASSWORD=local_oltp_loader

# ---------------------------------------------------------------------------
# Postgres — analytics warehouse (raw / staging / data products)
# ---------------------------------------------------------------------------
ANALYTICS_DB=analytics
ANALYTICS_SUPERUSER=postgres
ANALYTICS_SUPERUSER_PASSWORD=local_analytics_superuser
ANALYTICS_PORT=5433
# Role the platform loaders use to write raw schemas and the ingestion ledger
PLATFORM_LOADER_PASSWORD=local_platform_loader
# Per-domain role passwords (one role per domain — least privilege)
SALES_ROLE_PASSWORD=local_sales
CUSTOMER_ROLE_PASSWORD=local_customer
MARKETPLACE_ROLE_PASSWORD=local_marketplace
CUSTOMER_EXPERIENCE_ROLE_PASSWORD=local_customer_experience
REFERENCE_ROLE_PASSWORD=local_reference

# ---------------------------------------------------------------------------
# MinIO — landing zone + platform state
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=local_minio_admin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LANDING_BUCKET=landing
STATE_BUCKET=platform-state

# ---------------------------------------------------------------------------
# Kaggle — source of the Olist dataset (docs/production-readiness.md).
# Create a token at https://www.kaggle.com/settings -> API -> Create New Token,
# then set these from the downloaded kaggle.json (or mount ~/.kaggle/kaggle.json).
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
OLIST_DATASET=olistbr/brazilian-ecommerce

# ---------------------------------------------------------------------------
# Airflow 3 — orchestration (local dev values; production per
# docs/production-readiness.md: OIDC SSO, secrets backend, KubernetesExecutor).
# ---------------------------------------------------------------------------
AIRFLOW_DB_PASSWORD=local_airflow_meta
AIRFLOW_API_PORT=8080
# Generate real values: see README. Never commit the ones in .env.
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# NOTE: the host CLI reaches the databases/MinIO on localhost (defaults in
# settings.py + OLTP_PORT/ANALYTICS_PORT above). Inside the Airflow network the
# compose file overrides the hosts to the compose service names (postgres-oltp,
# postgres-analytics, minio) — so there is nothing to set here for that.

# ---------------------------------------------------------------- DataHub (catalog, M4) ---
# Local dev only; production uses DataHub's Helm chart + a secrets manager (production-readiness).
# GMS on 8081 so it does not collide with Airflow's apiserver on 8080.
DATAHUB_VERSION=v1.7.0.1
DATAHUB_MAPPED_GMS_PORT=8081
DATAHUB_MAPPED_FRONTEND_PORT=9002
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0
DATAHUB_TOKEN_SERVICE_SALT=dev_only_change_me_salt
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=dev_only_change_me_signing_key
