# Copy to .env and adjust. .env is gitignored and never committed (production reads
# secrets from a secrets manager — see docs/production-readiness.md X1).

# ---------------------------------------------------------------------------
# Postgres — operational source (stands in for the company's OLTP system)
# ---------------------------------------------------------------------------
OLTP_DB=shop_oltp
OLTP_SUPERUSER=postgres
OLTP_SUPERUSER_PASSWORD=local_oltp_superuser
OLTP_PORT=5432
# Least-privilege role the platform uses to read the source
OLTP_READER_PASSWORD=local_oltp_reader
# Role the seed step uses to load the Olist operational tables
OLTP_LOADER_PASSWORD=local_oltp_loader

# ---------------------------------------------------------------------------
# Postgres — analytics warehouse (raw / staging / data products)
# ---------------------------------------------------------------------------
ANALYTICS_DB=analytics
ANALYTICS_SUPERUSER=postgres
ANALYTICS_SUPERUSER_PASSWORD=local_analytics_superuser
ANALYTICS_PORT=5433
# Role the platform loaders use to write raw schemas and the ingestion ledger
PLATFORM_LOADER_PASSWORD=local_platform_loader
# Per-domain role passwords (one role per domain — least privilege)
SALES_ROLE_PASSWORD=local_sales
CUSTOMER_ROLE_PASSWORD=local_customer
MARKETPLACE_ROLE_PASSWORD=local_marketplace
CUSTOMER_EXPERIENCE_ROLE_PASSWORD=local_customer_experience
REFERENCE_ROLE_PASSWORD=local_reference
# Least-privilege consumer role the AI/BI tools connect as (output ports only; PII masked). M8/ADR-0013.
ANALYTICS_READER_PASSWORD=local_analytics_reader
# Unmask role — sees raw PII through the masking views (local: a login role; prod: a NOLOGIN group).
COMPLIANCE_PASSWORD=local_compliance
# Admin plane (X5): applies masking views + consumer grants instead of the superuser.
ACCESS_ADMIN_PASSWORD=local_access_admin
# Read-only metadata role DataHub ingests as (both databases).
CATALOG_READER_PASSWORD=local_catalog_reader
# One read-only role per federated domain agent (ADR-0021) — granted only its own domain's ports.
AGENT_SALES_PASSWORD=local_agent_sales
AGENT_CUSTOMER_PASSWORD=local_agent_customer
AGENT_MARKETPLACE_PASSWORD=local_agent_marketplace
AGENT_CUSTOMER_EXPERIENCE_PASSWORD=local_agent_customer_experience
AGENT_REFERENCE_PASSWORD=local_agent_reference

# ---------------------------------------------------------------------------
# MinIO — landing zone + platform state
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=local_minio_admin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Landing zone (ADR-0024): partner-facing inbox + object-locked archive (accepted/ + quarantine/).
LANDING_INBOX_BUCKET=landing-inbox
LANDING_ARCHIVE_BUCKET=landing-archive
# GOVERNANCE locally (an admin can still clean up); COMPLIANCE in production.
LANDING_LOCK_MODE=GOVERNANCE
# Least-privilege principals generated from sources.yml (platform/access/landing/principals.tsv).
# The loader drains the inbox and files to the archive; it is what ingestion runs as (never root).
LANDING_LOADER_USER=landing-loader
LANDING_LOADER_SECRET_KEY=local_landing_loader_secret
# One write-only partner per source: LANDING_PARTNER_<SOURCE>_SECRET (PoC simulator + proof P14).
LANDING_PARTNER_OLIST_SECRET=local_partner_olist_secret
STATE_BUCKET=platform-state
# dbt state (ADR-0015 §3): the published manifest per domain, read by Slim CI and --defer. The
# transform writes it as this principal (read/write on platform-state/dbt/* only), never as root.
DBT_STATE_USER=dbt-state
DBT_STATE_SECRET_KEY=local_dbt_state_secret
# Encryption at rest (X7): MinIO's built-in KMS with one static key — the local stand-in for KES +
# an external KMS. Format <key-name>:<base64 32 bytes>; generate: echo "dgp_key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=local_dgp_key:ZGdwLWxvY2FsLWRldi1vbmx5LWttcy1rZXktMzJieXQ=
# Backups (DR §3, proof P9). Production: a separate, object-locked, replicated location.
BACKUP_BUCKET=platform-backups

# ---------------------------------------------------------------------------
# Kaggle — source of the Olist dataset (docs/production-readiness.md).
# Create a token at https://www.kaggle.com/settings -> API -> Create New Token,
# then set these from the downloaded kaggle.json (or mount ~/.kaggle/kaggle.json).
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
OLIST_DATASET=olistbr/brazilian-ecommerce

# ---------------------------------------------------------------------------
# Airflow 3 — orchestration (local dev values; production per
# docs/production-readiness.md: OIDC SSO, secrets backend, KubernetesExecutor).
# ---------------------------------------------------------------------------
AIRFLOW_DB_PASSWORD=local_airflow_meta
AIRFLOW_API_PORT=8080
# Generate real values: see README. Never commit the ones in .env.
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# NOTE: the host CLI reaches the databases/MinIO on localhost (defaults in
# settings.py + OLTP_PORT/ANALYTICS_PORT above). Inside the Airflow network the
# compose file overrides the hosts to the compose service names (postgres-oltp,
# postgres-analytics, minio) — so there is nothing to set here for that.

# ---------------------------------------------------------------- DataHub (catalog, M4) ---
# Local dev only; production uses DataHub's Helm chart + a secrets manager (production-readiness).
# GMS on 8081 so it does not collide with Airflow's apiserver on 8080.
DATAHUB_VERSION=v1.7.0.1
DATAHUB_MAPPED_GMS_PORT=8081
DATAHUB_MAPPED_FRONTEND_PORT=9002
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0
DATAHUB_TOKEN_SERVICE_SALT=dev_only_change_me_salt
# HS256 requires a key >= 256 bits (>= 32 bytes). A shorter key makes GMS 500 on UI login
# ("Failed to generate session token"). Generate one with: openssl rand -base64 32
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=dev_only_change_me_signing_key_min_32_bytes!!

# ---------------------------------------------------------------- Superset (BI, M6) ---
# Local dev only; prod uses a real metadata DB + SSO + a secrets manager (production-readiness).
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=dev_only_change_me_superset_secret_key
SUPERSET_ADMIN=admin
SUPERSET_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------- pgAdmin (database UI) ---
# Local dev only (`make pgadmin`): desktop mode, no login; connects to every platform Postgres
# using the passwords above (written to a pgpass at start, never committed).
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local_pgadmin
