{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnQuarantine",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::landing-archive"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "quarantine/olist/reviews/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadOwnQuarantine",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::landing-archive/quarantine/olist/reviews/*"
      ]
    }
  ]
}
