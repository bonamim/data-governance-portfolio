{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DbtStateReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::platform-state/dbt/*"]
    },
    {
      "Sid": "ListDbtState",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::platform-state"],
      "Condition": {"StringLike": {"s3:prefix": ["dbt/*"]}}
    }
  ]
}
